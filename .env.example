MONGODB_URI=""
JWT_SECRET=""
# Ola 3 — OTP por WhatsApp (opcional): si ambas están presentes y no vacías,
# los códigos de verificación se envían por la WhatsApp Cloud API de Meta;
# si no, el backend usa el mock que imprime el código en su log.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Ola 4 — plantilla de autenticación (fuera de la ventana de 24h Meta solo
# permite plantillas). Defaults en código: "pymza_otp_verification" y "es".
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG=""
# Ola 5 — KYC/recibos: idioma del OCR (binario tesseract). Default en código:
# "spa" (un valor vacío usa el default).
OCR_LANG=""
# Ola 6 — CORS productivo: orígenes del frontend permitidos, separados por
# comas. Si falta o está vacía se usan los de dev (http://localhost:8080,
# http://127.0.0.1:8080). En Railway va el dominio público del frontend.
ALLOWED_ORIGINS=""
